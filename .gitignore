# Deny-by-default: only explicitly allow-listed paths below are tracked.
# This repo must NEVER contain the original game's assets (pack1/, pack2/,
# pack1-font*/, pack1-png/, pack1-script/, pack1-translate/, original/, etc.)
# The repo ships no game files at all — releases attach a standalone
# ThimbleweedPark.ggpack4 overlay file built locally from those assets.
/*

!/.gitignore
!/.github/
!/docs/
!/patch/
!/tools/
/tools/.dart_tool/
!/install/
!/*.md
/CLAUDE.md

# Delores mini-adventure sub-project - same deny-by-default rule applies.
# delores/original/ (raw Delores.ggpack1) must NEVER be tracked; only the
# transformative patch/install/fonts-korean work is allow-listed.
!/delores/
/delores/*
!/delores/patch/
!/delores/install/
!/delores/fonts-korean/
